PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ruleshark
JWT_SECRET=change-me-to-a-long-random-string
# Local Vite origin. On Vercel, leave unset to reflect the request Origin,
# or set to your deployment URL(s), comma-separated.
CLIENT_ORIGIN=http://localhost:5173
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# true = fake suggestions for local UI testing (also auto-on when OPENAI_API_KEY is empty)
MOCK_ANALYZE=true