PORT=4000
# Local Vite origin. On Vercel, leave unset to reflect the request Origin,
# or set to your deployment URL(s), comma-separated.
CLIENT_ORIGIN=http://localhost:5173
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# true = fake suggestions for local UI testing (also auto-on when OPENAI_API_KEY is empty)
MOCK_ANALYZE=true

# Per-IP LLM limits (rolling 1 hour). Tuned for ~$20/mo gpt-4o-mini spend.
LLM_RATE_LIMIT_REQUESTS=5
LLM_RATE_LIMIT_TOKENS=40000
# LLM_RATE_LIMIT_WINDOW_MS=3600000

# Global token budget across all clients (rolling 30 days) ≈ conservative $20/mo.
LLM_GLOBAL_TOKEN_BUDGET=40000000
# LLM_GLOBAL_TOKEN_WINDOW_MS=2592000000

# Agentic pipelines: orchestrator → specialists (analyze + test play).
# ANALYZE_AGENTIC=false for a single OpenAI call per workflow (cheaper).
ANALYZE_AGENTIC=true
